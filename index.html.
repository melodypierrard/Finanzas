<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Finanzas 2026</title>
    
    <!-- Configuración PWA para Icono y Pantalla Completa -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Finanzas 2026">
    <link rel="apple-touch-icon" href="https://cdn-icons-png.flaticon.com/512/10384/10384160.png">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap');
        
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background-color: #f8fafc; 
            padding-bottom: env(safe-area-inset-bottom);
            -webkit-user-select: none;
            touch-action: manipulation;
        }

        .safe-top { padding-top: env(safe-area-inset-top); }
        
        .card-glass {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 28px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.05);
        }

        .nav-active { color: #2563eb; transform: translateY(-4px); }
        .nav-active::after {
            content: '';
            position: absolute;
            bottom: -8px;
            width: 4px;
            height: 4px;
            background: #2563eb;
            border-radius: 50%;
        }

        /* Animaciones suaves */
        .fade-in { animation: fadeIn 0.3s ease-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body class="pb-24">

    <!-- Header Principal -->
    <div class="safe-top bg-white border-b border-slate-100 sticky top-0 z-40">
        <div class="px-6 py-4 flex justify-between items-center">
            <div>
                <h1 class="text-xl font-extrabold text-slate-900 tracking-tight">Finanzas<span class="text-blue-600">2026</span></h1>
                <p id="currentDateDisplay" class="text-[10px] font-bold text-slate-400 uppercase tracking-widest"></p>
            </div>
            <select id="monthSelector" onchange="updateApp()" class="bg-slate-100 border-none rounded-full px-4 py-2 text-xs font-bold text-slate-700 outline-none">
                <option value="0">Enero</option><option value="1">Febrero</option><option value="2">Marzo</option>
                <option value="3">Abril</option><option value="4">Mayo</option><option value="5">Junio</option>
                <option value="6">Julio</option><option value="7">Agosto</option><option value="8">Septiembre</option>
                <option value="9">Octubre</option><option value="10">Noviembre</option><option value="11">Diciembre</option>
            </select>
        </div>
    </div>

    <main class="p-6 max-w-lg mx-auto space-y-6">
        
        <!-- VISTA INICIO -->
        <div id="view-home" class="view-content space-y-6 fade-in">
            <!-- Balance Card -->
            <div class="bg-slate-900 rounded-[32px] p-8 text-white relative overflow-hidden shadow-2xl">
                <div class="relative z-10">
                    <p class="text-xs opacity-60 font-semibold mb-1">Balance Disponible</p>
                    <h2 id="balanceText" class="text-4xl font-black mb-6">$0</h2>
                    <div class="flex justify-between border-t border-white/10 pt-6">
                        <div>
                            <p class="text-[10px] opacity-50 font-bold uppercase mb-1">Ingresos</p>
                            <p id="incomeText" class="text-lg font-bold text-emerald-400">$0</p>
                        </div>
                        <div class="text-right">
                            <p class="text-[10px] opacity-50 font-bold uppercase mb-1">Gastos</p>
                            <p id="expenseText" class="text-lg font-bold text-red-400">$0</p>
                        </div>
                    </div>
                </div>
                <!-- Decoración -->
                <div class="absolute -right-10 -top-10 w-40 h-40 bg-blue-600/20 rounded-full blur-3xl"></div>
            </div>

            <!-- Formulario Rápido -->
            <div class="card-glass p-6">
                <h3 class="font-bold text-slate-800 mb-4 flex items-center gap-2">
                    <svg class="w-4 h-4 text-blue-500" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z"></path></svg>
                    Nuevo Registro
                </h3>
                <div class="space-y-3">
                    <input type="text" id="in-desc" placeholder="¿Qué compraste?" class="w-full bg-slate-50 p-4 rounded-2xl outline-none focus:ring-2 focus:ring-blue-100 transition">
                    <div class="flex gap-3">
                        <input type="number" id="in-amt" placeholder="Monto" class="w-2/3 bg-slate-50 p-4 rounded-2xl outline-none">
                        <input type="number" id="in-day" placeholder="Día" class="w-1/3 bg-slate-50 p-4 rounded-2xl outline-none">
                    </div>
                    <div class="flex gap-2 p-1 bg-slate-100 rounded-2xl">
                        <button onclick="setType('expense')" id="btn-exp" class="flex-1 py-3 rounded-xl text-xs font-bold transition bg-white shadow-sm text-slate-900">Gasto</button>
                        <button onclick="setType('income')" id="btn-inc" class="flex-1 py-3 rounded-xl text-xs font-bold transition text-slate-400">Ingreso</button>
                    </div>
                    <button onclick="saveItem()" class="w-full bg-blue-600 text-white font-bold py-4 rounded-2xl shadow-lg shadow-blue-200 active:scale-95 transition">Añadir Movimiento</button>
                </div>
            </div>

            <!-- Lista Reciente -->
            <div id="historyList" class="space-y-3">
                <!-- Items dinámicos -->
            </div>
        </div>

        <!-- VISTA STATS -->
        <div id="view-stats" class="view-content hidden fade-in space-y-6">
            <div class="card-glass p-6">
                <h3 class="font-bold text-slate-800 mb-6">Tendencia 2026</h3>
                <div class="h-64"><canvas id="mainChart"></canvas></div>
            </div>
            <div id="categoryStats" class="space-y-3"></div>
        </div>

    </main>

    <!-- Barra de Navegación Inferior -->
    <nav class="fixed bottom-6 left-6 right-6 h-20 card-glass flex justify-around items-center px-4 z-50 border-none shadow-2xl">
        <button onclick="changeTab('home')" class="nav-btn nav-active flex flex-col items-center relative">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
            <span class="text-[9px] font-bold mt-1 uppercase tracking-tighter">Inicio</span>
        </button>
        <button onclick="changeTab('stats')" class="nav-btn text-slate-300 flex flex-col items-center relative">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            <span class="text-[9px] font-bold mt-1 uppercase tracking-tighter">Stats</span>
        </button>
        <button onclick="exportJSON()" class="text-slate-300 flex flex-col items-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            <span class="text-[9px] font-bold mt-1 uppercase tracking-tighter">Backup</span>
        </button>
    </nav>

    <script>
        let currentType = 'expense';
        let db = JSON.parse(localStorage.getItem('finanzas_v2026')) || {
            monthly: Array.from({ length: 12 }, () => [])
        };
        let myChart = null;

        function setType(t) {
            currentType = t;
            const isExp = t === 'expense';
            document.getElementById('btn-exp').className = isExp ? 'flex-1 py-3 rounded-xl text-xs font-bold transition bg-white shadow-sm text-slate-900' : 'flex-1 py-3 rounded-xl text-xs font-bold transition text-slate-400';
            document.getElementById('btn-inc').className = !isExp ? 'flex-1 py-3 rounded-xl text-xs font-bold transition bg-white shadow-sm text-slate-900' : 'flex-1 py-3 rounded-xl text-xs font-bold transition text-slate-400';
        }

        function changeTab(tab) {
            document.querySelectorAll('.view-content').forEach(v => v.classList.add('hidden'));
            document.getElementById(`view-${tab}`).classList.remove('hidden');
            document.querySelectorAll('.nav-btn').forEach(btn => btn.classList.remove('nav-active', 'text-blue-600'));
            document.querySelectorAll('.nav-btn').forEach(btn => btn.classList.add('text-slate-300'));
            event.currentTarget.classList.add('nav-active', 'text-blue-600');
            if(tab === 'stats') renderChart();
        }

        function saveItem() {
            const m = parseInt(document.getElementById('monthSelector').value);
            const desc = document.getElementById('in-desc').value;
            const amt = parseFloat(document.getElementById('in-amt').value);
            const day = parseInt(document.getElementById('in-day').value) || new Date().getDate();

            if(!desc || isNaN(amt)) return;

            db.monthly[m].push({ id: Date.now(), desc, amt, day, type: currentType });
            localStorage.setItem('finanzas_v2026', JSON.stringify(db));
            
            document.getElementById('in-desc').value = '';
            document.getElementById('in-amt').value = '';
            updateApp();
        }

        function deleteItem(m, id) {
            db.monthly[m] = db.monthly[m].filter(i => i.id !== id);
            localStorage.setItem('finanzas_v2026', JSON.stringify(db));
            updateApp();
        }

        function updateApp() {
            const m = parseInt(document.getElementById('monthSelector').value);
            const items = db.monthly[m];
            
            let inc = 0, exp = 0;
            items.forEach(i => i.type === 'income' ? inc += i.amt : exp += i.amt);
            
            document.getElementById('balanceText').innerText = `$${(inc - exp).toLocaleString()}`;
            document.getElementById('incomeText').innerText = `$${inc.toLocaleString()}`;
            document.getElementById('expenseText').innerText = `$${exp.toLocaleString()}`;

            const list = document.getElementById('historyList');
            list.innerHTML = '<h4 class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-2 mb-2">Movimientos del mes</h4>';
            
            [...items].sort((a,b) => b.day - a.day).forEach(i => {
                list.innerHTML += `
                    <div class="card-glass p-5 flex justify-between items-center fade-in">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded-2xl ${i.type === 'income' ? 'bg-emerald-100 text-emerald-600' : 'bg-slate-100 text-slate-600'} flex items-center justify-center font-bold text-xs">
                                ${i.day}
                            </div>
                            <div>
                                <p class="font-bold text-slate-800 text-sm">${i.desc}</p>
                                <p class="text-[9px] font-bold text-slate-400 uppercase tracking-tighter">${i.type === 'income' ? 'Ingreso' : 'Gasto Corriente'}</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4">
                            <span class="font-extrabold text-sm ${i.type === 'income' ? 'text-emerald-500' : 'text-slate-900'}">
                                ${i.type === 'income' ? '+' : '-'}$${i.amt.toLocaleString()}
                            </span>
                            <button onclick="deleteItem(${m}, ${i.id})" class="text-slate-200">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12"></path></svg>
                            </button>
                        </div>
                    </div>
                `;
            });
        }

        function renderChart() {
            const ctx = document.getElementById('mainChart').getContext('2d');
            const dataInc = db.monthly.map(m => m.filter(i => i.type === 'income').reduce((a, b) => a + b.amt, 0));
            const dataExp = db.monthly.map(m => m.filter(i => i.type === 'expense').reduce((a, b) => a + b.amt, 0));

            if(myChart) myChart.destroy();
            myChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['E','F','M','A','M','J','J','A','S','O','N','D'],
                    datasets: [
                        { label: 'Ingresos', data: dataInc, borderColor: '#10b981', backgroundColor: '#10b98120', fill: true, tension: 0.4 },
                        { label: 'Gastos', data: dataExp, borderColor: '#ef4444', backgroundColor: '#ef444420', fill: true, tension: 0.4 }
                    ]
                },
                options: { 
                    responsive: true, 
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { display: false }, x: { grid: { display: false } } }
                }
            });
        }

        function exportJSON() {
            const data = JSON.stringify(db);
            const blob = new Blob([data], {type: 'application/json'});
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `backup_finanzas_2026.json`;
            a.click();
        }

        // Init
        const d = new Date();
        document.getElementById('monthSelector').value = d.getMonth();
        document.getElementById('currentDateDisplay').innerText = d.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' });
        updateApp();
    </script>
</body>
</html>

